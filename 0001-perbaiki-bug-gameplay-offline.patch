diff --git a/src/logic/turnLogic.js b/src/logic/turnLogic.js
new file mode 100644
index 0000000..83289fa
--- /dev/null
+++ b/src/logic/turnLogic.js
@@ -0,0 +1,21 @@
+// ============================================================
+// turnLogic.js — Urutan giliran (fungsi pure, tanpa dependensi)
+// ============================================================
+
+/**
+ * Tentukan index pemain yang main berikutnya.
+ * - Double dan tidak masuk penjara → giliran sama (lempar lagi).
+ * - Selain itu → pemain AKTIF berikutnya setelah `currentIndex`
+ *   menurut urutan meja. `currentIndex` boleh menunjuk pemain yang
+ *   baru saja bangkrut; urutannya tetap dihitung dari posisinya,
+ *   bukan dari daftar pemain aktif (yang sudah tidak memuat dia).
+ */
+export const getNextTurn = (currentIndex, players, rolledDouble, wentToJail) => {
+  if (rolledDouble && !wentToJail) return currentIndex; // giliran lagi
+  const count = players.length;
+  for (let offset = 1; offset <= count; offset += 1) {
+    const index = (currentIndex + offset) % count;
+    if (!players[index].bankrupt) return index;
+  }
+  return currentIndex; // tidak ada pemain aktif
+};
diff --git a/src/logic/turnLogic.test.js b/src/logic/turnLogic.test.js
new file mode 100644
index 0000000..c66d170
--- /dev/null
+++ b/src/logic/turnLogic.test.js
@@ -0,0 +1,34 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { getNextTurn } from './turnLogic.js';
+
+const table = (bankrupt = []) =>
+  [0, 1, 2, 3].map((id) => ({ id, bankrupt: bankrupt.includes(id) }));
+
+test('giliran lanjut ke pemain berikutnya dan memutar ke awal', () => {
+  const players = table();
+  assert.equal(getNextTurn(0, players, false, false), 1);
+  assert.equal(getNextTurn(3, players, false, false), 0);
+});
+
+test('double tanpa masuk penjara memberi giliran lagi, masuk penjara tidak', () => {
+  const players = table();
+  assert.equal(getNextTurn(2, players, true, false), 2);
+  assert.equal(getNextTurn(2, players, true, true), 3);
+});
+
+test('pemain bangkrut dilewati', () => {
+  assert.equal(getNextTurn(0, table([1]), false, false), 2);
+  assert.equal(getNextTurn(0, table([1, 2]), false, false), 3);
+});
+
+test('setelah pemain tengah bangkrut, giliran ke pemain berikutnya di meja (bukan ke awal)', () => {
+  // Regresi: dulu P1/P2 bangkrut selalu melempar giliran ke P0.
+  assert.equal(getNextTurn(1, table([1]), false, false), 2);
+  assert.equal(getNextTurn(2, table([2]), false, false), 3);
+  assert.equal(getNextTurn(3, table([3]), false, false), 0);
+});
+
+test('hanya satu pemain aktif tersisa → tetap pemain itu', () => {
+  assert.equal(getNextTurn(2, table([0, 1, 3]), false, false), 2);
+});
diff --git a/src/utils/logSound.js b/src/utils/logSound.js
new file mode 100644
index 0000000..4fa6b8f
--- /dev/null
+++ b/src/utils/logSound.js
@@ -0,0 +1,20 @@
+// ============================================================
+// logSound.js — Pilih efek suara dari teks baris log permainan
+// ============================================================
+
+const RULES = [
+  ['buy', /membeli|memenangkan lelang/i],
+  ['money', /menerima|bonus|lewat MULAI|Parkir Gratis/i],
+  ['jail', /penjara/i],
+  ['lose', /bangkrut/i],
+];
+
+/**
+ * @param {string} text — isi teks baris log (`entry.text`, bukan objeknya)
+ * @returns {'buy'|'money'|'jail'|'lose'|null}
+ */
+export const soundForLogText = (text) => {
+  if (typeof text !== 'string') return null;
+  const match = RULES.find(([, pattern]) => pattern.test(text));
+  return match ? match[0] : null;
+};
diff --git a/src/utils/logSound.test.js b/src/utils/logSound.test.js
new file mode 100644
